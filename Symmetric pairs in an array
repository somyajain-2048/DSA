// Function to find symmetric pairs
vector<vector<int>> findSymmetricPairs(vector<vector<int>>& arr){
int n = arr.size();
vector<vector<int>>result;

for(int i = 0;i<n;i++){
for(int j = i+1; j<n;j++){
if(arr[i][0] == arr[j][1] && arr[i][1] == arr[j][0]){
result.push(arr[i]);
}
}
}
return result;
}

