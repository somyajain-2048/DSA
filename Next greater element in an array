class Solution {
public:
    vector<int> nextLargerElement(vector<int>& arr) {
        stack<int> st;
        vector<int> ans(arr.size(), -1); // default -1

        for (int i = 0; i < arr.size(); i++) {
            // Keep popping while current element is greater
            while (!st.empty() && arr[st.top()] < arr[i]) {
                ans[st.top()] = arr[i];
                st.pop();
            }
            st.push(i);
        }
        return ans;
    }
};
